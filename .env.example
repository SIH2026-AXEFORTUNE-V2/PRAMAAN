# Copy to .env and fill in. .env is git-ignored; never commit a real token.

# OpenAI API key (preferred when set; billed per use). Serves text + vision + transcription (GPT-5.4 mini),
# illustrations (gpt-image-1-mini), designed infographics with read-back verification (gpt-image-2) and
# multilingual narration (gpt-4o-mini-tts). Groq below becomes the automatic text fallback.
OPENAI_API_KEY=
# OPENAI_TEXT_MODEL=gpt-5.4-mini,gpt-4.1-mini
# OPENAI_IMAGE_MODEL=gpt-image-1-mini
# OPENAI_INFOGRAPHIC_MODEL=gpt-image-2
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=alloy

# GroqCloud API key (recommended: generous free tier, fast). When set, Groq serves all text agents
# and Whisper transcription; HF_TOKEN below is then only used for images / scanned PDFs.
GROQ_API_KEY=
# GROQ_TEXT_MODEL=openai/gpt-oss-120b,openai/gpt-oss-20b
# LLM_PROVIDER=auto              # auto | openai | groq | huggingface | gateway | offline

# Visual Agent (illustrations) via Cloudflare Workers AI (FLUX.1 [schnell]); free daily allowance.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell

# Video production, preferred: JSON2Video cloud renderer (AI images, Azure voices incl. Indian languages, subtitles).
# Free plan: 600 s of rendering in total, 60 s max per video, small watermark. Falls back to local rendering.
JSON2VIDEO_API_KEY=
# J2V_VOICE=en-US-AriaNeural
# Local video fallback: narration uses the Cloudflare credentials above (Deepgram Aura-2).
# Optional real motion clips per scene via Pollinations (Amazon Nova Reel); without a key scenes use animated stills.
POLLINATIONS_API_KEY=
# VIDEO_MODEL=amazon/nova-reel-v1   # free Quest tier (~0.48 pollen/clip); alibaba/wan-2.2-fast is ~10x cheaper but needs paid balance
# VIDEO_MOTION_MAX=1                 # scenes per video that get real motion (the rest are animated stills)
# TTS_MODEL=@cf/deepgram/aura-2-en

# Hugging Face access token with "Make calls to Inference Providers" permission.
# Leave empty to run fully offline (built-in samples + extractive engine).
HF_TOKEN=

# Optional overrides (comma-separated lists are tried in order)
# HF_PROVIDER=auto
# HF_TEXT_MODEL=meta-llama/Llama-3.3-70B-Instruct,Qwen/Qwen2.5-72B-Instruct,meta-llama/Llama-3.1-8B-Instruct

# Self-hosted OpenAI-compatible gateway (vLLM / TGI / LiteLLM). When set, inference stays on-prem.
# MODEL_GATEWAY_URL=http://localhost:8001/v1
# HF_VISION_MODEL=Qwen/Qwen2.5-VL-72B-Instruct,Qwen/Qwen2.5-VL-7B-Instruct
# HF_ASR_MODEL=openai/whisper-large-v3
# HF_MAX_TOKENS=6000

# PRAMAAN_DEMO_MODE=1          # force the offline engine even when HF_TOKEN is set
# PRAMAAN_MAX_UPLOAD_MB=50
# PRAMAAN_MAX_SOURCE_CHARS=60000
# PRAMAAN_MAX_PARALLEL=4
