# Copy to .env and fill in. .env is git-ignored; never commit a real token.

# GroqCloud API key (recommended: generous free tier, fast). When set, Groq serves all text agents
# and Whisper transcription; HF_TOKEN below is then only used for images / scanned PDFs.
GROQ_API_KEY=
# GROQ_TEXT_MODEL=openai/gpt-oss-120b,openai/gpt-oss-20b
# LLM_PROVIDER=auto              # auto | groq | huggingface | gateway | offline

# Visual Agent (illustrations) via Cloudflare Workers AI (FLUX.1 [schnell]); free daily allowance.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell

# Hugging Face access token with "Make calls to Inference Providers" permission.
# Leave empty to run fully offline (built-in samples + extractive engine).
HF_TOKEN=

# Optional overrides (comma-separated lists are tried in order)
# HF_PROVIDER=auto
# HF_TEXT_MODEL=meta-llama/Llama-3.3-70B-Instruct,Qwen/Qwen2.5-72B-Instruct,meta-llama/Llama-3.1-8B-Instruct

# Self-hosted OpenAI-compatible gateway (vLLM / TGI / LiteLLM). When set, inference stays on-prem.
# MODEL_GATEWAY_URL=http://localhost:8001/v1
# HF_VISION_MODEL=Qwen/Qwen2.5-VL-72B-Instruct,Qwen/Qwen2.5-VL-7B-Instruct
# HF_ASR_MODEL=openai/whisper-large-v3
# HF_MAX_TOKENS=6000

# PRAMAAN_DEMO_MODE=1          # force the offline engine even when HF_TOKEN is set
# PRAMAAN_MAX_UPLOAD_MB=50
# PRAMAAN_MAX_SOURCE_CHARS=60000
# PRAMAAN_MAX_PARALLEL=4
